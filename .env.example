# Supabase — encontre em: supabase.com/dashboard/project/zigghtvlmftgjlohuhla/settings/api
VITE_SUPABASE_URL=https://zigghtvlmftgjlohuhla.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Anthropic — adicione no painel do Vercel como variável de ambiente
# A chave NUNCA vai para o browser — fica exclusivamente no servidor Vercel
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI — usada só para gerar embeddings (text-embedding-3-small) da Base
# de Conhecimento IA (RAG). Também exclusiva do servidor Vercel.
OPENAI_API_KEY=sk-...

# Service Role do Supabase — usada por api/rag-index.js e api/rag-sync-batch.js
# (mesmo padrão de api/admin-create-user.js). NUNCA vai para o browser.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado entre o trigger do Postgres (rag_notificar_index) e
# api/rag-index.js — gere um valor aleatório e use o MESMO valor em:
#   alter database postgres set app.settings.rag_webhook_secret = '...';
RAG_WEBHOOK_SECRET=
